{
  "manifest_version": 3,
  "name": "Figma 繁體中文",
  "short_name": "Figma 繁體中文",
  "description": "繁體中文 Figma 插件。",
  "version": "1.1.1",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.figma.com/*"],
      "js": [
        "src/data/translations.js",
        "src/content/translation-engine.js",
        "src/content/index.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
